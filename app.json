{
  "expo": {
    "name": "Casa Madridista",
    "slug": "casamadridistaApp",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": "casamadridistaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.casamadridistaApp",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Casa Madridista uses the camera so you can take photos for your profile, community posts and Casa Media match-day reports.",
        "NSPhotoLibraryUsageDescription": "Casa Madridista accesses your photos so you can choose images and videos for your profile, posts and Casa Media uploads.",
        "NSPhotoLibraryAddUsageDescription": "Casa Madridista saves photos you download from the community feed to your device photo library.",
        "NSMicrophoneUsageDescription": "Casa Madridista uses the microphone to record voice messages, and the sound of videos you capture for posts, messages and Casa Media match-day reports."
      },
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "associatedDomains": [
        "applinks:dashboard.casamadridista.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundImage": "./assets/icons/adaptive-icon.png",
        "monochromeImage": "./assets/icons/adaptive-icon.png"
      },
      "package": "com.anonymous.casamadridistaApp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dashboard.casamadridista.com",
              "pathPrefix": "/m"
            },
            {
              "scheme": "https",
              "host": "dashboard.casamadridista.com",
              "pathPrefix": "/match"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/icons/splash-icon-light.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "expo-apple-authentication",
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Casa Madridista saves photos you download from the community feed to your device photo library.",
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/adaptive-icon.png",
          "color": "#BC9045",
          "defaultChannel": "casa-media"
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-compressor",
      [
        "expo-audio",
        {
          "microphonePermission": "Casa Madridista uses the microphone to record voice messages, and the sound of videos you capture for posts, messages and Casa Media match-day reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab472561-144d-41eb-8157-18cf09267313"
      }
    },
    "owner": "petrenko52",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab472561-144d-41eb-8157-18cf09267313"
    }
  }
}
